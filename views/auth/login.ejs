<%- include('../partials/head') %>
<div class="auth-split">
  <div class="auth-left">
    <div class="auth-logo-text">
      <div class="auth-logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
      </div>
      SmartBiz Insight
    </div>

    <div class="auth-hero-title">Business data in. Clear decisions out.</div>
    <div class="auth-hero-subtitle">Track products, customers and sales in one place, then read the numbers as KPIs, trends, low-stock alerts and a revenue forecast.</div>

    <div class="auth-features">
      <div class="auth-feature">
        <div class="auth-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
        </div>
        Revenue, sales, profit and customer KPIs at a glance
      </div>
      <div class="auth-feature">
        <div class="auth-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        </div>
        Rule-based restock alerts from reorder levels
      </div>
      <div class="auth-feature">
        <div class="auth-feature-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
        </div>
        7-day revenue forecast from historical sales
      </div>
    </div>

    <div class="auth-footer">
      Small Business Decision Support System
    </div>
  </div>

  <div class="auth-right">
    <div class="auth-card">
      <div class="card-title">Sign in</div>
      <div class="card-subtitle">Use your business account to continue.</div>

      <%- include('../partials/flash') %>

      <form method="POST" action="/login">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autofocus />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%; margin-top: 16px;">Sign in</button>
      </form>
      <div style="text-align: center; margin-top: 24px; font-size: 13px; color: var(--muted);">
        No account yet? <a href="/register" style="font-weight: 500;">Create one</a>
      </div>
      
      <div class="auth-secure" style="justify-content: center; text-align: center; margin-top: 24px; font-size: 11px;">
        Access is role based: owner, manager and viewer see different actions.
      </div>
    </div>
  </div>
</div>
</body>
</html>
