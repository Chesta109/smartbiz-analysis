<%- include('../partials/head') %>
<main class="auth-simple-page">
  <section class="auth-card" aria-labelledby="forgot-title">
    <a class="auth-brand" href="/login">SmartBiz Insight</a>
    <h1 class="card-title" id="forgot-title">Reset your password</h1>
    <p class="card-subtitle">Enter your account email and we’ll send a one-time verification code.</p>
    <%- include('../partials/flash') %>
    <form method="POST" action="/forgot-password">
      <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required autofocus></div>
      <button class="btn btn-primary auth-submit" type="submit">Send verification code</button>
    </form>
    <p class="auth-link-row"><a href="/login">Back to sign in</a></p>
  </section>
</main>
