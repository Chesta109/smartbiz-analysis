<%- include('../partials/appStart', { activeNav: '/customers', title: 'Customers', user: (typeof user !== 'undefined' ? user : null) }) %>

<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: var(--space-4); margin-top: 8px;">
  <div>
    <h1 style="margin:0; font-size:24px; font-weight: 700; color: var(--ink);">Customers</h1>
    <div style="color: var(--muted); font-size: 14px; margin-top: 4px;">Your customer directory and their purchase history.</div>
  </div>
  <button class="btn btn-primary" onclick="openCustomerModal()">+ Add customer</button>
</div>

<div class="card" style="padding: 0;">
  <div style="padding: 24px 24px 0;">
    <div style="font-weight: 600; font-size: 16px; color: var(--ink); margin-bottom: 4px;"><%= customers.length %> customers</div>
    <div style="font-size: 14px; color: var(--muted); margin-bottom: 24px;">Select a customer to view their purchase history.</div>
    
    <form method="GET" action="/customers" style="display: flex; gap: 12px; margin-bottom: 24px;">
      <div class="search-bar" style="flex: 1;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" name="search" placeholder="Search by name, email or phone..." value="<%= filters.search %>" />
      </div>
    </form>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="padding-left: 24px;">Customer</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Orders</th>
          <th>Total spend</th>
          <th>Last purchase</th>
          <th style="padding-right: 24px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% customers.forEach(function(c) { %>
          <tr id="customer-row-<%= c.id %>" data-customer-id="<%= c.id %>">
            <td class="customer-col-name" style="padding-left: 24px; font-weight: 500; color: var(--ink);"><%= c.name %></td>
            <td class="customer-col-email"><%= c.email || '—' %></td>
            <td class="customer-col-phone"><%= c.phone || '—' %></td>
            <td><%= Number(c.orders || 0) %></td>
            <td>₹<%= Number(c.total_spend || 0).toFixed(0) %></td>
            <td>
              <%
                const rawDate = c.last_purchase;
                const parsedDate = rawDate ? new Date(rawDate) : null;
                const isValidDate = parsedDate && !isNaN(parsedDate.getTime());
              %>
              <% if (isValidDate) { %>
                <%= parsedDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              <% } else { %>
                <span class="badge badge-secondary" style="background: var(--bg); color: var(--muted);">• No purchases</span>
              <% } %>
            </td>
            <td style="padding-right: 24px; white-space: nowrap;">
              <a href="/customers/<%= c.id %>" style="font-size: 13px; font-weight: 500; color: var(--primary); margin-right: 10px;">View</a>
              <a href="#" class="action-link action-edit" style="font-size: 13px; font-weight: 500; color: var(--primary); margin-right: 10px;"
                 id="edit-customer-btn-<%= c.id %>"
                 data-customer="<%= encodeURIComponent(JSON.stringify(c)) %>"
                 onclick='openCustomerModal(JSON.parse(decodeURIComponent(this.dataset.customer))); return false;'>Edit</a>
              <form method="POST" action="/customers/<%= c.id %>" class="inline-action-form" onsubmit="return confirm('Delete this customer? Customers with purchase history are protected.');">
                <input type="hidden" name="_method" value="DELETE">
                <button class="action-link action-delete" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
        <% if (customers.length === 0) { %>
          <tr><td colspan="7" style="text-align:center; color: var(--muted); padding: 32px 0;">No customers found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/customerModal') %>
<script src="/js/customers.js"></script>
<%- include('../partials/appEnd') %>
