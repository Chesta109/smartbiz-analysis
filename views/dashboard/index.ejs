<script src="/js/charts.js"></script>
<%- include('../partials/appStart', { activeNav: '/dashboard', title: 'Dashboard', user }) %>

<div style="display: flex; justify-content: space-between; align-items: flex-start;">
  <section class="page-heading">
    <h1 style="font-size: 20px;">Dashboard</h1>
    <p>Business overview and decision insights.</p>
  </section>
  <div style="display: flex; gap: 8px; margin-top: 8px; align-items: center;">

    <!-- Date Filter -->
    <select
        id="date-filter"
        class="form-select"
        style="width: auto; height: 36px; font-size: 13px;"
    >
        <option value="30" selected>Last 30 days</option>
        <option value="7">Last 7 days</option>
        <option value="90">Last 90 days</option>
        <option value="this_month">This month</option>
        <option value="last_month">Last month</option>
        <option value="this_year">This year</option>
        <option value="all">All time</option>
    </select>


    <!-- Category Filter -->
    <select
        id="category-filter"
        class="form-select"
        style="width: auto; height: 36px; font-size: 13px;"
    >
        <option value="all" selected>
            All Categories
        </option>
    </select>


    <!-- Refresh -->
    <button
        id="refresh-dashboard"
        class="btn btn-secondary"
        style="height: 36px; font-size: 13px;"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="width: 14px; height: 14px;"
        >
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
        </svg>

        Refresh
    </button>
    
</div>
</div>

<div class="grid grid-4" style="margin-bottom: var(--space-4);">
  <% metrics.forEach(function(metric, i) { %>
  <article class="card">
    <div class="card-subtitle" style="font-weight: 500; color: var(--ink); font-size: 14px;">
      <%= metric.label %>
    </div>

    <div class="kpi-value" id="kpi-<%= i %>">
      <%= metric.value %>
    </div>
  </article>
<% }) %>
</div>

<div class="grid" style="grid-template-columns: 1fr 1fr; margin-bottom: var(--space-4);">
  <section class="card" style="display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <div>
        <div class="card-title">Low stock</div>
        <div class="card-subtitle">Products below their reorder level.</div>
      </div>
      <a href="/products" style="font-size: 13px; font-weight: 600;">All products →</a>
    </div>
    
    <div id="low-stock-list" style="display: flex; flex-direction: column; gap: 0;">
    <div style="text-align: center; color: var(--muted); font-size: 13px; padding: 24px 0;">
        Loading inventory alerts...
    </div>
</div>
  </section>

  <section class="card">
    <div class="card-title">Business recommendations</div>
    <div class="card-subtitle" style="margin-bottom: 24px;">Rule-based alerts, statistical insights and machine learning outputs.</div>
    
    <div
    id="business-recommendations"
    style="display: flex; flex-direction: column; gap: 0;"
>
    <div style="
        text-align: center;
        color: var(--muted);
        font-size: 13px;
        padding: 24px 0;
    ">
        Loading business recommendations...
    </div>
</div>
  </section>
</div>

<div class="grid" style="grid-template-columns: 2fr 1fr; margin-bottom: var(--space-4);">
  <section class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <div>
        <div class="card-title">Revenue trend</div>
        <div class="card-subtitle">Monthly revenue trend</div>
      </div>
    </div>
    <div 
  id="revenue-trend-chart"
  style="height: 240px; display: flex; flex-direction: column; justify-content: space-around;"
>
  <div style="text-align: center; color: var(--muted); font-size: 13px;">
    Loading revenue trend...
  </div>
</div>


  </section>

  <section class="card">
    <div class="card-title">Best-performing products</div>
    <div class="card-subtitle" style="margin-bottom: 24px;">By revenue in the selected period</div>
    <div
  id="product-performance-chart"
  style="height: 240px; display: flex; flex-direction: column; justify-content: space-around;"
>
  <div style="text-align: center; color: var(--muted); font-size: 13px;">
    Loading product performance...
  </div>
</div>

<div
  style="display: flex; justify-content: space-between; margin-top: 8px;
         font-size: 11px; color: var(--muted); padding-left: 72px;"
>
  <span>₹0</span>
  <span>Revenue</span>
</div>
  </section>
</div>
<%- include('_forecast') %>

<%- include('../partials/appEnd') %>
