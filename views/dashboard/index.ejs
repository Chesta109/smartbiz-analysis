<%- include('../partials/appStart', { activeNav: '/dashboard', title: 'Dashboard', user }) %>

<div style="display: flex; justify-content: space-between; align-items: flex-start;">
  <section class="page-heading">
    <h1 style="font-size: 20px;">Dashboard</h1>
    <p>Business overview and decision insights.</p>
  </section>
  <div style="display: flex; gap: 8px; margin-top: 8px;">
    <select class="form-select" style="width: auto; height: 36px; font-size: 13px;">
      <option>Last 30 days</option>
    </select>
    <button class="btn btn-secondary" style="height: 36px; font-size: 13px;">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
      Refresh
    </button>
  </div>
</div>

<div class="grid grid-4" style="margin-bottom: var(--space-4);">
  <% metrics.forEach(function(metric, i) { %>
    <%
      let trendText = '+20.5% from last period';
      let trendClass = 'badge-success';
      if (i === 1) { trendText = '+10.2% from last period'; }
      if (i === 2) { trendText = '+14.5% from last period'; }
      if (i === 3) { trendText = '+34.5% from last period'; }
    %>
    <article class="card">
      <div class="card-subtitle" style="font-weight: 500; color: var(--ink); font-size: 14px;"><%= metric.label %></div>
      <div class="kpi-value"><%= metric.value %></div>
      <div class="kpi-trend">
        <span class="badge <%= trendClass %>" style="font-size: 10px; padding: 2px 6px;">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 10px; height: 10px; margin-right: 2px;"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
          <%= trendText.split(' ')[0] %>
        </span>
        <span style="color: var(--muted);"><%= trendText.split(' ').slice(1).join(' ') %></span>
      </div>
    </article>
  <% }) %>
</div>

<div class="grid" style="grid-template-columns: 1fr 1fr; margin-bottom: var(--space-4);">
  <section class="card" style="display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <div>
        <div class="card-title">Low stock</div>
        <div class="card-subtitle">Products below their reorder level.</div>
      </div>
      <a href="/products" style="font-size: 13px; font-weight: 600;">All products →</a>
    </div>
    
    <div style="display: flex; flex-direction: column; gap: 0;">
      <% if (lowStockItems.length) { %>
        <% lowStockItems.forEach(function(product, index) { %>
          <% let statusClass = product.stock_qty === 0 ? 'status-out' : 'status-low'; %>
          <% let statusLabel = product.stock_qty === 0 ? 'Out of stock' : 'Low stock'; %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: <%= index < lowStockItems.length - 1 ? '1px solid var(--line)' : 'none' %>;">
            <div>
              <div style="font-weight: 600; font-size: 14px; color: var(--ink);"><%= product.name %></div>
              <div style="font-size: 13px; color: var(--muted);">Stock: <%= product.stock_qty %> · Reorder level: <%= product.reorder_level %></div>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
              <span class="<%= statusClass %> status-dot"><%= statusLabel %></span>
              <button class="btn btn-outline btn-sm">Restock</button>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state" style="padding: 24px 0;">
          <span style="font-size: 14px;">All products are above their reorder level.</span>
        </div>
      <% } %>
    </div>
  </section>

  <section class="card">
    <div class="card-title">Business recommendations</div>
    <div class="card-subtitle" style="margin-bottom: 24px;">Rule-based alerts, statistical insights and machine learning outputs.</div>
    
    <div style="display: flex; flex-direction: column; gap: 0;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--line);">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Restock Sticky Notes (5x5, 3-pack)</div>
          <div style="font-size: 13px; color: var(--muted); max-width: 320px;">Stock is depleted to reorder level of 15. This product is currently out of stock.</div>
        </div>
        <span class="tag-pill tag-rule">Rule-based</span>
      </div>
      
      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--line);">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Restock Cotton Hand Towel</div>
          <div style="font-size: 13px; color: var(--muted); max-width: 320px;">Current stock is 20, which is below the configured reorder level of 25.</div>
        </div>
        <span class="tag-pill tag-rule">Rule-based</span>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--line);">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Restock Wireless Mouse</div>
          <div style="font-size: 13px; color: var(--muted); max-width: 320px;">Current stock is 4, which is below the configured reorder level of 10.</div>
        </div>
        <span class="tag-pill tag-rule">Rule-based</span>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--line);">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Revenue trending up</div>
          <div style="font-size: 13px; color: var(--muted); max-width: 320px;">Revenue is up 17.5% compared with the previous 30-day period.</div>
        </div>
        <span class="tag-pill tag-stat">Statistical</span>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--line);">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Margin warning on 3 products</div>
          <div style="font-size: 13px; color: var(--muted); max-width: 320px;">Executive Board and RealEstaters are selling at margins below 10%. Review pricing or supplier costs.</div>
        </div>
        <span class="tag-pill tag-stat">Statistical</span>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 0;">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Predicted revenue next 7 days</div>
          <div style="font-size: 13px; color: var(--muted); max-width: 320px;">+84,150 (+12%). This is an expected based on a slight post-holiday market holiday facility.</div>
        </div>
        <span class="tag-pill tag-ml">Machine learning</span>
      </div>
    </div>
  </section>
</div>

<div class="grid" style="grid-template-columns: 2fr 1fr; margin-bottom: var(--space-4);">
  <section class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <div>
        <div class="card-title">Revenue trend</div>
        <div class="card-subtitle">Last 30 days</div>
      </div>
      <div style="display: flex; border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden;">
        <button style="border: none; background: var(--bg); padding: 4px 12px; font-size: 12px; font-weight: 600; color: var(--ink); border-right: 1px solid var(--line);">Daily</button>
        <button style="border: none; background: var(--white); padding: 4px 12px; font-size: 12px; font-weight: 500; color: var(--muted); border-right: 1px solid var(--line);">Weekly</button>
        <button style="border: none; background: var(--white); padding: 4px 12px; font-size: 12px; font-weight: 500; color: var(--muted);">Monthly</button>
      </div>
    </div>
    <div style="height: 240px; border-bottom: 1px solid var(--line); position: relative;">
      <!-- Placeholder for Revenue Trend Chart -->
      <div style="position: absolute; bottom: 0; left: 0; right: 0; top: 20px;">
        <svg preserveAspectRatio="none" viewBox="0 0 100 100" style="width:100%; height:100%;">
          <path d="M0,80 Q10,70 20,80 T40,60 T60,80 T80,50 T100,60 L100,100 L0,100 Z" fill="rgba(37,99,235,0.1)"></path>
          <path d="M0,80 Q10,70 20,80 T40,60 T60,80 T80,50 T100,60" fill="none" stroke="#2563EB" stroke-width="2"></path>
        </svg>
      </div>
    </div>
    <div style="display: flex; justify-content: space-between; margin-top: 8px; font-size: 11px; color: var(--muted);">
      <span>Jul 01</span><span>Jul 05</span><span>Jul 10</span><span>Jul 15</span><span>Jul 20</span><span>Jul 25</span><span>Jul 30</span><span>Aug 04</span><span>Aug 09</span>
    </div>
  </section>

  <section class="card">
    <div class="card-title">Best-performing products</div>
    <div class="card-subtitle" style="margin-bottom: 24px;">By revenue in the selected period</div>
    <div style="height: 240px; display: flex; flex-direction: column; justify-content: space-around;">
      <!-- Placeholder for Best-performing products chart -->
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 11px; width: 60px; text-align: right; color: var(--muted);">Wireless Mouse</span>
        <div style="flex: 1; height: 16px; background: #2563EB; border-radius: 2px;"></div>
      </div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 11px; width: 60px; text-align: right; color: var(--muted);">Cotton Hand Towel</span>
        <div style="flex: 1; height: 16px; background: #1D4ED8; border-radius: 2px; width: 85%;"></div>
      </div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 11px; width: 60px; text-align: right; color: var(--muted);">Sticky Notes (5x5)</span>
        <div style="flex: 1; height: 16px; background: #3B82F6; border-radius: 2px; width: 70%;"></div>
      </div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 11px; width: 60px; text-align: right; color: var(--muted);">Wireless Mouse</span>
        <div style="flex: 1; height: 16px; background: #60A5FA; border-radius: 2px; width: 55%;"></div>
      </div>
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 11px; width: 60px; text-align: right; color: var(--muted);">USB-C Cable (1m)</span>
        <div style="flex: 1; height: 16px; background: #93C5FD; border-radius: 2px; width: 40%;"></div>
      </div>
    </div>
    <div style="display: flex; justify-content: space-between; margin-top: 8px; font-size: 11px; color: var(--muted); padding-left: 72px;">
      <span>0k</span><span>10k</span><span>20k</span><span>30k</span><span>40k</span>
    </div>
  </section>
</div>

<section class="card" style="margin-bottom: var(--space-4);">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
    <div>
      <div class="card-title">Revenue forecast — next 7 days</div>
      <div class="card-subtitle">Solid line is actual historical, dashed line is the predicted revenue.</div>
    </div>
    <button class="btn btn-outline btn-sm">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;"><line x1="21" y1="15" x2="21" y2="19"></line><line x1="21" y1="19" x2="15" y2="19"></line><line x1="21" y1="19" x2="14" y2="12"></line><line x1="3" y1="19" x2="10" y2="12"></line><line x1="10" y1="12" x2="14" y2="16"></line></svg>
      Reports
    </button>
  </div>
  
  <div style="display: flex; gap: 32px; height: 260px;">
    <div style="flex: 1; position: relative; border-bottom: 1px solid var(--line);">
      <!-- Chart placeholder -->
      <div style="position: absolute; bottom: 0; left: 0; right: 0; top: 20px;">
        <svg preserveAspectRatio="none" viewBox="0 0 100 100" style="width:100%; height:100%;">
          <path d="M0,80 Q10,70 20,80 T40,60 T60,80 T80,50 T100,60" fill="none" stroke="#2563EB" stroke-width="2"></path>
          <path d="M100,60 Q110,65 120,55" fill="none" stroke="#10B981" stroke-width="2" stroke-dasharray="4"></path>
        </svg>
      </div>
      <div style="display: flex; justify-content: space-between; position: absolute; bottom: -24px; left: 0; right: 0; font-size: 11px; color: var(--muted);">
        <span>Jul 01</span><span>Jul 05</span><span>Jul 10</span><span>Jul 15</span><span>Jul 20</span><span>Jul 25</span><span>Jul 30</span><span>Aug 04</span><span>Aug 09</span><span>Aug 14</span><span>Aug 19</span><span>Aug 24</span>
      </div>
    </div>
    
    <div style="width: 280px; padding: 24px; background: var(--bg); border-radius: var(--radius-sm); border: 1px solid var(--line);">
      <span class="tag-pill tag-ml" style="margin-bottom: 12px;">Machine learning</span>
      <div style="font-size: 24px; font-weight: 700; color: var(--ink); margin-bottom: 4px;">₹84,150</div>
      <div style="font-size: 13px; color: var(--muted); margin-bottom: 24px;">Expected total revenue for Jul 13 - Aug 19 2026.</div>
      
      <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ink);">
          <div style="width: 16px; height: 2px; background: #2563EB;"></div> Historical revenue
        </div>
        <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ink);">
          <div style="width: 16px; height: 2px; background: #10B981; border-top: 2px dashed #10B981;"></div> Forecast
        </div>
      </div>
      
      <div style="font-size: 11px; color: var(--muted); line-height: 1.5;">
        Forecast generated using historical daily sales trends. Accuracy depends on how much sales history has been recorded.
      </div>
    </div>
  </div>
</section>

<%- include('../partials/appEnd') %>
