<%- include('../partials/appStart', { activeNav: '/settings', title: 'Settings', user: (typeof user !== 'undefined' ? user : null) }) %>

<section class="page-heading" style="margin-top: 8px;">
  <h1 style="font-size:24px; font-weight: 700; color: var(--ink); margin-bottom: 4px;">Settings</h1>
  <p>Manage your profile and understand your access level.</p>
</section>

<div class="grid grid-1-2" style="grid-template-columns: 2fr 1fr; margin-bottom: var(--space-4);">
  <div class="card" style="padding: 0;">
    <div style="padding: 24px; border-bottom: 1px solid var(--line);">
      <div class="card-title">Profile</div>
      <div class="card-subtitle">Your personal account information</div>
    </div>
    
    <div style="padding: 24px;">
      <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: #DBEAFE; color: #1E3A8A; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 600;">
          <%= user?.name ? user.name.trim().charAt(0).toUpperCase() : '?' %>
        </div>
        <div>
          <button class="btn btn-outline btn-sm">Change avatar</button>
          <div style="font-size: 13px; color: var(--muted); margin-top: 4px;">JPG, GIF or PNG. 1MB max.</div>
        </div>
      </div>

      <form method="POST" action="/settings">
        <input type="hidden" name="_method" value="PUT" />
        <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="field">
            <label>Full name</label>
            <input class="form-control" name="name" value="<%= user?.name || '' %>" placeholder="Your name" required />
          </div>
          <div class="field">
            <label>Email</label>
            <input class="form-control" type="email" name="email" value="<%= user?.email || '' %>" placeholder="you@example.com" required />
          </div>
        </div>
        
        <div class="field">
          <label>Role</label>
          <input class="form-control" value="<%= user?.role ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : 'Business owner' %>" readonly style="background: var(--bg);" />
          <div style="font-size: 13px; color: var(--muted); margin-top: 6px;">Roles dictate access. Contact your account owner if this is incorrect.</div>
        </div>
        
        <button type="submit" class="btn btn-primary" style="margin-top: 8px;">Save changes</button>
      </form>
    </div>
  </div>

  <div style="display: flex; flex-direction: column; gap: 24px;">
    <div class="card" style="padding: 0;">
      <div style="padding: 24px; border-bottom: 1px solid var(--line);">
        <div class="card-title">Role management</div>
        <div class="card-subtitle">Your current permissions</div>
      </div>
      <div style="padding: 24px; display: flex; align-items: flex-start; gap: 16px;">
        <div style="padding: 12px; background: #FEF3C7; color: #D97706; border-radius: 50%;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
        </div>
        <div>
          <div style="font-weight: 600; color: var(--ink); font-size: 14px;"><%= user?.role ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : 'Business owner' %></div>
          <div style="font-size: 13px; color: var(--muted); margin-top: 4px; line-height: 1.5;">Permission details are managed by your existing role middleware.</div>
        </div>
      </div>
    </div>

    <div class="card" style="padding: 0;">
      <div style="padding: 24px; border-bottom: 1px solid var(--line);">
        <div class="card-title">Organization</div>
      </div>
      <div style="padding: 24px;">
        <div style="font-size: 13px; color: var(--ink); margin-bottom: 8px;">
          <strong>SmartBiz Retail Ltd.</strong>
        </div>
        <div style="font-size: 13px; color: var(--muted); margin-bottom: 16px;">
          Business ID: SBR-9843-1<br>
          Billing cycle: Monthly
        </div>
        <button class="btn btn-outline btn-sm">Manage organization</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/appEnd') %>
