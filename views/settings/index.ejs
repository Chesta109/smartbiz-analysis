<%- include('../partials/appStart', { activeNav: '/settings', title: 'Settings', user: (typeof user !== 'undefined' ? user : null) }) %>

<section class="page-heading" style="margin-top: 8px;">
  <h1 style="font-size:24px; font-weight: 700; color: var(--ink); margin-bottom: 4px;">Settings</h1>
  <p>Manage your profile.</p>
</section>

<div class="card" style="padding: 0; max-width: 600px; margin: 0 auto; margin-bottom: var(--space-4);">
  <div style="padding: 24px; border-bottom: 1px solid var(--line);">
    <div class="card-title">Profile</div>
    <div class="card-subtitle">Your personal account information</div>
  </div>
  
  <div style="padding: 24px;">
    <form method="POST" action="/settings">
      <input type="hidden" name="_method" value="PUT" />
      <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="field">
          <label>Full name</label>
          <input class="form-control" name="name" value="<%= user?.name || '' %>" placeholder="Your name" required maxlength="120" />
        </div>
        <div class="field">
          <label>Email</label>
          <input class="form-control" type="email" name="email" value="<%= user?.email || '' %>" placeholder="you@example.com" required maxlength="160" />
        </div>
      </div>
      
      <div class="field">
        <label>Role</label>
        <input class="form-control" value="<%= user?.role ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : 'Business owner' %>" readonly style="background: var(--bg);" />
      </div>
      
      <button type="submit" class="btn btn-primary" style="margin-top: 8px;">Save changes</button>
    </form>
  </div>
</div>

<%- include('../partials/appEnd') %>
