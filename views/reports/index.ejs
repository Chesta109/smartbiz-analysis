<%- include('../partials/appStart', { activeNav: '/reports', title: 'Reports', user: (typeof user !== 'undefined' ? user : null) }) %>

<section class="page-heading" style="margin-top: 8px;">
  <h1 style="font-size:24px; font-weight: 700; color: var(--ink); margin-bottom: 4px;">Reports</h1>
  <p>Generate and download reports for your business.</p>
</section>

<div class="card" style="padding: 0; max-width: 600px; margin: 0 auto; margin-bottom: var(--space-4);">
  <div style="padding: 24px; border-bottom: 1px solid var(--line);">
    <div class="card-title">Sales report</div>
    <div class="card-subtitle">Complete transaction ledger with product breakdown.</div>
  </div>
  
  <div style="padding: 24px;">
    <form id="reportForm" class="grid" style="grid-template-columns: 1fr; gap: 16px;">
      <div id="reportError" class="flash flash-error" style="display:none; padding:8px 12px;"></div>
      <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="field" style="margin-bottom: 0;">
          <label>From date</label>
          <input id="fromDate" class="form-control" type="date" />
        </div>
        <div class="field" style="margin-bottom: 0;">
          <label>To date</label>
          <input id="toDate" class="form-control" type="date" />
        </div>
      </div>

      <div style="font-size: 13px; color: var(--muted); margin-bottom: 8px;">
        Generates a complete transaction ledger for the selected date range. Includes breakdown by product category and payment method.
      </div>
      
      <div style="display: flex; gap: 12px; margin-top: 8px;">
        <a id="btnCsv" href="#" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Download CSV
        </a>
        <a id="btnPdf" href="#" class="btn btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          Download PDF
        </a>
      </div>
    </form>
  </div>
</div>

<script>
  const fromInput = document.getElementById('fromDate');
  const toInput = document.getElementById('toDate');
  const btnCsv = document.getElementById('btnCsv');
  const btnPdf = document.getElementById('btnPdf');
  const reportError = document.getElementById('reportError');

  const today = new Date();
  const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
  const formatDate = d => {
    const y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,'0'), date = String(d.getDate()).padStart(2,'0');
    return `${y}-${m}-${date}`;
  };

  const todayStr = formatDate(today);
  fromInput.value = formatDate(firstDay);
  toInput.value = todayStr;
  fromInput.max = todayStr;
  toInput.max = todayStr;

  function updateLinks() {
    reportError.style.display = 'none';
    const f = new Date(fromInput.value);
    const t = new Date(toInput.value);
    
    if (isNaN(f) || isNaN(t)) {
      btnCsv.removeAttribute('href');
      btnPdf.removeAttribute('href');
      return;
    }

    if (f > t) {
      reportError.textContent = 'From date cannot be after To date.';
      reportError.style.display = 'block';
      btnCsv.removeAttribute('href');
      btnPdf.removeAttribute('href');
      return;
    }
    const diff = (t - f) / (1000 * 60 * 60 * 24);
    if (diff > 366) {
      reportError.textContent = 'Date range cannot exceed 366 days.';
      reportError.style.display = 'block';
      btnCsv.removeAttribute('href');
      btnPdf.removeAttribute('href');
      return;
    }

    btnCsv.href = \`/reports/sales.csv?from=\${fromInput.value}&to=\${toInput.value}\`;
    btnPdf.href = \`/reports/sales.pdf?from=\${fromInput.value}&to=\${toInput.value}\`;
  }

  fromInput.addEventListener('change', updateLinks);
  toInput.addEventListener('change', updateLinks);
  updateLinks();

  btnCsv.addEventListener('click', (e) => {
    if (!btnCsv.getAttribute('href')) e.preventDefault();
  });
  btnPdf.addEventListener('click', (e) => {
    if (!btnPdf.getAttribute('href')) e.preventDefault();
  });
</script>

<%- include('../partials/appEnd') %>
