<%- include('../partials/appStart', { activeNav: '/reports' , title: 'Reports' , user: (typeof user !=='undefined' ?
  user : null) }) %>

  <section class="page-heading" style="margin-top: 8px;">
    <h1 style="font-size:24px; font-weight:700; color:var(--ink); margin-bottom:4px;">Reports</h1>
    <p>Generate and download reports for your business.</p>
  </section>

  <div class="card" style="padding:0; max-width:600px; margin:0 auto; margin-bottom:var(--space-4);">
    <div style="padding:24px; border-bottom:1px solid var(--line);">
      <div class="card-title">Sales report</div>
      <div class="card-subtitle">Complete transaction ledger with product breakdown.</div>
    </div>

    <div style="padding:24px;">
      <form id="reportForm" class="grid" style="grid-template-columns:1fr; gap:16px;" novalidate>
        <div id="reportError" class="flash flash-error" role="alert" aria-live="polite"
          style="display:none; padding:8px 12px;"></div>

        <div class="grid grid-2" style="gap:16px;">
          <div class="field" style="margin-bottom:0;">
            <label for="fromDate">From date</label>
            <input id="fromDate" name="from" class="form-control" type="date" required />
          </div>

          <div class="field" style="margin-bottom:0;">
            <label for="toDate">To date</label>
            <input id="toDate" name="to" class="form-control" type="date" required />
          </div>
        </div>

        <div style="font-size:13px; color:var(--muted); margin-bottom:8px;">
          Generates a transaction ledger for the selected date range, including breakdowns by product category and
          payment method.
        </div>

        <div style="display:flex; gap:12px; margin-top:8px; flex-wrap:wrap;">
          <a id="btnCsv" href="#" class="btn btn-primary" aria-label="Download sales report as CSV">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="margin-right:4px;" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download CSV
          </a>

          <a id="btnPdf" href="#" class="btn btn-secondary" aria-label="Download sales report as PDF">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="margin-right:4px;" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Download PDF
          </a>
        </div>
      </form>
    </div>
  </div>

  <script>
    (function () {
      const fromInput = document.getElementById('fromDate');
      const toInput = document.getElementById('toDate');
      const btnCsv = document.getElementById('btnCsv');
      const btnPdf = document.getElementById('btnPdf');
      const reportError = document.getElementById('reportError');

      if (!fromInput || !toInput || !btnCsv || !btnPdf || !reportError) {
        console.error('Reports page: required form elements are missing.');
        return;
      }

      function formatDate(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');

        return `${year}-${month}-${day}`;
      }

      const today = new Date();
      const todayStr = formatDate(today);
      const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

      fromInput.value = formatDate(firstDay);
      toInput.value = todayStr;

      fromInput.max = todayStr;
      toInput.max = todayStr;

      function disableLinks() {
        btnCsv.removeAttribute('href');
        btnPdf.removeAttribute('href');

        btnCsv.setAttribute('aria-disabled', 'true');
        btnPdf.setAttribute('aria-disabled', 'true');
      }

      function enableLinks(csvUrl, pdfUrl) {
        btnCsv.href = csvUrl;
        btnPdf.href = pdfUrl;

        btnCsv.removeAttribute('aria-disabled');
        btnPdf.removeAttribute('aria-disabled');
      }

      function showError(message) {
        reportError.textContent = message;
        reportError.style.display = 'block';
      }

      function clearError() {
        reportError.textContent = '';
        reportError.style.display = 'none';
      }

      function updateLinks() {
        clearError();
        disableLinks();

        const fromValue = fromInput.value;
        const toValue = toInput.value;

        if (!fromValue || !toValue) {
          showError('Please select both the From date and To date.');
          return;
        }

        // Strict YYYY-MM-DD validation avoids ambiguous date strings.
        const datePattern = /^\d{4}-\d{2}-\d{2}$/;

        if (!datePattern.test(fromValue) || !datePattern.test(toValue)) {
          showError('Please select valid dates.');
          return;
        }

        const fromDate = new Date(`${fromValue}T00:00:00`);
        const toDate = new Date(`${toValue}T00:00:00`);

        if (
          Number.isNaN(fromDate.getTime()) ||
          Number.isNaN(toDate.getTime()) ||
          formatDate(fromDate) !== fromValue ||
          formatDate(toDate) !== toValue
        ) {
          showError('Please select valid dates.');
          return;
        }

        if (fromValue > toValue) {
          showError('From date cannot be after To date.');
          return;
        }

        if (fromValue > todayStr || toValue > todayStr) {
          showError('Future dates are not allowed.');
          return;
        }

        const dayDifference = Math.round(
          (Date.UTC(
            toDate.getFullYear(),
            toDate.getMonth(),
            toDate.getDate()
          ) - Date.UTC(
            fromDate.getFullYear(),
            fromDate.getMonth(),
            fromDate.getDate()
          )) / 86400000
        );

        if (dayDifference > 366) {
          showError('Date range cannot exceed 366 days.');
          return;
        }

        const params = new URLSearchParams({
          from: fromValue,
          to: toValue
        });

        enableLinks(
          `/reports/sales.csv?${params.toString()}`,
          `/reports/sales.pdf?${params.toString()}`
        );
      }

      fromInput.addEventListener('change', updateLinks);
      toInput.addEventListener('change', updateLinks);

      // Prevent navigation while the selected date range is invalid.
      btnCsv.addEventListener('click', function (event) {
        if (!btnCsv.getAttribute('href')) {
          event.preventDefault();
          updateLinks();
        }
      });

      btnPdf.addEventListener('click', function (event) {
        if (!btnPdf.getAttribute('href')) {
          event.preventDefault();
          updateLinks();
        }
      });

      updateLinks();
    })();
  </script>

  <%- include('../partials/appEnd') %>