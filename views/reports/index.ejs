<%- include('../partials/appStart', { activeNav: '/reports', title: 'Reports', user: (typeof user !== 'undefined' ? user : null) }) %>

<section class="page-heading" style="margin-top: 8px;">
  <h1 style="font-size:24px; font-weight: 700; color: var(--ink); margin-bottom: 4px;">Reports</h1>
  <p>Generate and download reports for your business.</p>
</section>

<div class="grid grid-1-2" style="grid-template-columns: 1fr 1fr; margin-bottom: var(--space-4);">
  <div class="card" style="padding: 0;">
    <div style="padding: 24px; border-bottom: 1px solid var(--line);">
      <div class="card-title">Report filters</div>
      <div class="card-subtitle">Choose the report and date range you need.</div>
    </div>
    
    <div style="padding: 24px;">
      <form class="grid" style="grid-template-columns: 1fr; gap: 16px;">
        <div class="field" style="margin-bottom: 0;">
          <label>Report type</label>
          <select class="form-select">
            <option>Sales report</option>
            <option>Inventory report</option>
            <option>Customer report</option>
            <option>Tax summary</option>
          </select>
        </div>
        
        <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="field" style="margin-bottom: 0;">
            <label>From</label>
            <input class="form-control" type="date" />
          </div>
          <div class="field" style="margin-bottom: 0;">
            <label>To</label>
            <input class="form-control" type="date" />
          </div>
        </div>

        <div style="font-size: 13px; color: var(--muted); margin-bottom: 8px;">
          Generates a complete transaction ledger for the selected date range. Includes breakdown by product category and payment method.
        </div>
        
        <div style="display: flex; gap: 12px; margin-top: 8px;">
          <button class="btn btn-primary" type="button" disabled style="opacity: 0.5; cursor: not-allowed;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Download CSV
          </button>
          <button class="btn btn-secondary" type="button" disabled style="opacity: 0.5; cursor: not-allowed;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Download PDF
          </button>
        </div>
        <div style="font-size: 12px; color: var(--muted);">Available once the report route is connected.</div>
      </form>
    </div>
  </div>

  <div class="card" style="padding: 0;">
    <div style="padding: 24px; border-bottom: 1px solid var(--line);">
      <div class="card-title">Available reports</div>
      <div class="card-subtitle">Commonly requested formats.</div>
    </div>
    
    <div style="display: flex; flex-direction: column;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 20px 24px; border-bottom: 1px solid var(--line);">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Sales report</div>
          <div style="font-size: 13px; color: var(--muted);">Complete transaction ledger with product breakdown.</div>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn btn-secondary btn-sm" style="padding: 6px; width: 32px; height: 32px;">CSV</button>
          <button class="btn btn-secondary btn-sm" style="padding: 6px; width: 32px; height: 32px;">PDF</button>
        </div>
      </div>
      
      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 20px 24px; border-bottom: 1px solid var(--line);">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Inventory report</div>
          <div style="font-size: 13px; color: var(--muted);">Current stock levels and valuations.</div>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn btn-secondary btn-sm" style="padding: 6px; width: 32px; height: 32px;">CSV</button>
          <button class="btn btn-secondary btn-sm" style="padding: 6px; width: 32px; height: 32px;">PDF</button>
        </div>
      </div>
      
      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 20px 24px; border-bottom: 1px solid var(--line);">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Customer report</div>
          <div style="font-size: 13px; color: var(--muted);">Customer directory with LTV (lifetime value) stats.</div>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn btn-secondary btn-sm" style="padding: 6px; width: 32px; height: 32px;">CSV</button>
          <button class="btn btn-secondary btn-sm" style="padding: 6px; width: 32px; height: 32px;">PDF</button>
        </div>
      </div>
      
      <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 20px 24px;">
        <div>
          <div style="font-weight: 600; font-size: 14px; color: var(--ink);">Tax summary</div>
          <div style="font-size: 13px; color: var(--muted);">Pre-calculated tax liabilities for compliance.</div>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn btn-secondary btn-sm" style="padding: 6px; width: 32px; height: 32px;">CSV</button>
          <button class="btn btn-secondary btn-sm" style="padding: 6px; width: 32px; height: 32px;">PDF</button>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/appEnd') %>
